# User OAuth token (xoxp-...). All sends and resolves use this — messages and
# uploads will be attributed to the human user who installed the app.
SLACK_USER_TOKEN=xoxp-...

# App-level token (xapp-...) with connections:write. Used by the Socket Mode
# listener to receive message events.
SLACK_APP_TOKEN=xapp-...

# Footer appended to outgoing text messages and edits. Default `_— AI_`
# (markdown italic). Set to an empty string to disable, or override with your
# own marker. Only appended when the caller-supplied text is non-empty.
# SLACK_SEND_FOOTER=_— AI_
